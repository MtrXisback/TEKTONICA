# ============================================================================
# PLANTILLA DE CONFIGURACIÓN DE BASE DE DATOS DE PRODUCCIÓN - TEKTONICA
# ============================================================================
#
# INSTRUCCIONES:
# 1. Copia este archivo con el nombre '.env' en la raíz del proyecto:
#    cp .env.example .env
# 2. Modifica los valores con credenciales altamente seguras y personalizadas.
# 3. NUNCA subas el archivo '.env' real al repositorio público de GitHub.

# Nombre de la base de datos relacional PostgreSQL
DB_NAME=proyectogeo_db

# Usuario administrador oficial para producción
DB_USER=geo_admin

# Contraseña de alta complejidad para producción (Ej: contraseña aleatoria robusta)
DB_PASSWORD=tektonica_secure_pass_production_change_me

# Puerto externo mapeado en el servidor para pgAdmin o mantenimiento remoto
DB_PORT_OUT=5432
